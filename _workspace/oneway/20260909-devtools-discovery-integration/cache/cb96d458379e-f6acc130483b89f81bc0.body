  var MAP = {"English":"EN","Deutsch":"DE","Espa\u00f1ol (M\u00e9xico)":"ES-LA","Espa\u00f1ol (Latinoam\u00e9rica)":"ES-LA","Espa\u00f1ol (Espa\u00f1a)":"ES-SP","Fran\u00e7ais":"FR","Italiano":"IT","Portugu\u00eas (Brasil)":"PT","\u4e2d\u6587\uff08\u7e41\u9ad4\uff09":"ZH","\u4e2d\u6587\uff08\u7b80\u4f53\uff09":"ZH","\u65e5\u672c\u8a9e":"JP","\ud55c\uad6d\uc5b4":"KO","\u0627\u0644\u0639\u0631\u0628\u064a\u0629":"AR"};
  function relabel(sr) {
