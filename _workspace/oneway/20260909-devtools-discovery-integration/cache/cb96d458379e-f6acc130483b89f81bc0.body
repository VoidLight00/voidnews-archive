        if (!m) continue;
        var a = m[4] === undefined ? 1 : parseFloat(m[4]);
        if (a < 0.5) continue;
        var l = (0.2126 * +m[1] + 0.7152 * +m[2] + 0.0722 * +m[3]) / 255;
        return l > 0.5 ? '#171719' : '#FAFAFA';
      }
    } catch (e) {}
    return null;
  }
  function inView(e) {
    var r = e.getBoundingClientRect();
    return r.width > 0 && r.top < 100 && r.bottom > 0 && r.left >= -2 && r.right <= window.innerWidth + 2;
  }
  var writing = false;
  function position(host) {
    writing = true;
    var cta = Array.prototype.slice.call(document.querySelectorAll('a[href*="contact"]')).filter(inView)[0];
    var burger = Array.prototype.slice.call(document.querySelectorAll('[data-framer-name*="Menu"]')).filter(inView)[0];
    var anchor = cta || burger;
    var s = host.style;
    if (anchor) {
      var r = anchor.getBoundingClientRect();
      s.setProperty('--wf-chip-h', Math.round(r.height) + 'px');
      /* Desktop sits 8px from the CTA. On mobile the chip has no stroke at rest, so it can tuck
         in to 2px from the hamburger; once the menu opens it becomes a filled pill and needs the
         full 8px so it does not touch the burger. */
      s.setProperty('right', Math.round(document.documentElement.clientWidth - r.left + (cta ? 8 : 2)) + 'px', 'important');
      /* Outline on desktop only; no stroke on mobile. box-sizing is border-box and the width/height
         come from --wf-chip-w/h, so dropping the border does not change the box or its alignment. */
      s.setProperty('--wf-chip-bw', cta ? '1px' : '0px');
      s.setProperty('top', Math.round(r.top) + 'px', 'important');
      if (cta) {
        var kids = cta.querySelectorAll('*');
        for (var k = 0; k < kids.length; k++) {
          var fc = kids[k].childNodes[0];
          if (fc && fc.nodeType === 3 && (kids[k].textContent || '').trim()) { s.setProperty('--wf-chip-fs', getComputedStyle(kids[k]).fontSize); break; }
        }
      }
    } else {
      s.setProperty('--wf-chip-h', 'auto');
      s.setProperty('right', '20px', 'important');
      s.setProperty('top', '14px', 'important');
    }
    s.setProperty('bottom', 'unset', 'important');
    s.setProperty('left', 'unset', 'important');
    var rest = null, invertSrc = null;
    /* Mirror only links in the SAME ROW as the nav CTA, and only ones actually rendered.
       Without this, an unstyled link in the banner ABOVE the nav ('Read more', browser-default
       rgb(0,0,238)) wins the document-order race and forces the chip dark even over dark
       sections. Row-matching makes the chip follow the real nav, so it flips with Framer own
       White/Dark nav variants as the section behind it changes. */
    var rowCy = 32;
    if (anchor) { var _ar = anchor.getBoundingClientRect(); rowCy = _ar.top + _ar.height / 2; }
    var navLink = Array.prototype.slice.call(document.querySelectorAll('a')).filter(function (e) {
      if (!inView(e)) return false;
      if ((e.getAttribute('href') || '').indexOf('contact') !== -1) return false;
      if ((e.innerText || '').trim().length <= 2) return false;
      var ecs = getComputedStyle(e);
      if (ecs.visibility === 'hidden' || parseFloat(ecs.opacity) < 0.5) return false;
      var er = e.getBoundingClientRect();
      return Math.abs((er.top + er.height / 2) - rowCy) <= 14;
    })[0];
    if (navLink) { rest = getComputedStyle(navLink).color; invertSrc = navLink; }
    else if (burger) {
      var kids = burger.querySelectorAll('svg path, svg line, svg rect, div');
      for (var q = 0; q < kids.length && !rest; q++) {
        var kcs = getComputedStyle(kids[q]);
        if (kids[q].tagName === 'DIV') {
          if (kcs.backgroundColor && kcs.backgroundColor !== 'transparent' && kcs.backgroundColor.indexOf('rgba(0, 0, 0, 0)') === -1) rest = kcs.backgroundColor;
        } else {
          if (kcs.stroke && kcs.stroke !== 'none') rest = kcs.stroke;
          else if (kcs.fill && kcs.fill !== 'none' && kcs.fill.indexOf('rgba(0, 0, 0, 0)') === -1) rest = kcs.fill;
        }
      }
      invertSrc = burger;
    }
    var inv = 'none', p = invertSrc;
    for (var i = 0; i < 10 && p && p !== document.documentElement; i++) { var f = getComputedStyle(p).filter; if (f && f.indexOf('invert') !== -1) { inv = f; break; } p = p.parentElement; }
    var im = inv.match(/invert\((\d*\.?\d+)(%?)\)/);
    var amt = im ? (im[2] ? parseFloat(im[1]) / 100 : parseFloat(im[1])) : 0;
    var lum = 0;
    if (rest) {
      var cm = rest.match(/rgba?\(([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)/);
      if (cm) {
        var rr = +cm[1], gg = +cm[2], bb = +cm[3];
        if (amt >= 0.5) { rr = 255 - rr; gg = 255 - gg; bb = 255 - bb; }
        lum = (0.2126 * rr + 0.7152 * gg + 0.0722 * bb) / 255;
      }
      s.setProperty('--wf-rest', lum > 0.5 ? '#FAFAFA' : '#171719');
    }
    /* No nav link to mirror (mobile): match the section behind the chip instead */
    if (!navLink) {
      var bp = backdropPick(host);
      if (bp) s.setProperty('--wf-rest', bp);
    }
    requestAnimationFrame(function () { writing = false; });
  }
  function inject() {
    var host = document.querySelector('.scLangSelector');
    var sr = host && host.shadowRoot;
    if (!sr) return false;
    if (!sr.querySelector('#wf-lang-style')) {
      var st = document.createElement('style');
      st.id = 'wf-lang-style';
      st.textContent = CSS;
      sr.appendChild(st);
    }
    relabel(sr);
    syncWidth(sr, host);
    position(host);
    if (!sr.__wfObs) {
      sr.__wfObs = new MutationObserver(function () { relabel(sr); syncWidth(sr, host); });
      sr.__wfObs.observe(sr, { childList: true, subtree: true, characterData: true });
    }
    if (!host.__wfHover && window.matchMedia('(hover: hover)').matches) {
      host.__wfHover = true;
      var closeTimer = null;
      var getPanel = function () { return sr.querySelector('.scLangPanel'); };
      var getLabel = function () { return sr.querySelector('.scLangSelectorLabel'); };
      host.addEventListener('mouseenter', function () {
        if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
        var p = getPanel(); var l = getLabel();
        if (p && l && p.classList.contains('hidden')) l.click();
      });
      host.addEventListener('mouseleave', function () {
        if (closeTimer) clearTimeout(closeTimer);
        closeTimer = setTimeout(function () {
          var p = getPanel(); var l = getLabel();
          if (p && l && !p.classList.contains('hidden')) l.click();
        }, 200);
      });
      sr.addEventListener('click', function (ev) {
        var p = getPanel();
        if (ev.isTrusted && ev.target.closest && ev.target.closest('.scLangSelectorLabel') && p && !p.classList.contains('hidden')) {
          ev.stopImmediatePropagation(); ev.preventDefault();
        }
