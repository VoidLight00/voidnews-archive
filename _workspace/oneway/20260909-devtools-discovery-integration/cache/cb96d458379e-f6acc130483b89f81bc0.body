<script>
(function () {
  try {
    var PUBLISHED = ['es-MX','fr','de','ja','it','zh-Hant','pt-BR','en'];
    var REMAP = {
      'es-419':'es-MX', 'es-ES':'es-MX', 'es':'es-MX',
      'zh-Hans':'zh-Hant', 'zh':'zh-Hant',
      'pt':'pt-BR',
      'ko':'en', 'ar':'en',
      'he':'en', 'he-IL':'en', 'iw':'en'
    };
    var CONFIGURED = ['es-MX','fr','de','ja','it','ko','zh-Hans','zh-Hant','ar','pt-BR',
                      'es-ES','es-419','en','es','zh','pt','he','he-IL','iw'];

    var stored = window.localStorage.getItem('scLang');
    if (stored) {
      // A published choice is the visitor's own - leave it alone.
      if (PUBLISHED.indexOf(stored) === -1) {
        window.localStorage.setItem('scLang', REMAP[stored] || 'en');
      }
      return;
    }

    if (/[?&]scLang=/i.test(location.search)) return;

    var langs = navigator.languages || (navigator.language ? [navigator.language] : []);
    for (var i = 0; i < langs.length; i++) {
      var l = langs[i];
      if (!l || CONFIGURED.indexOf(l) === -1) continue;
      if (REMAP[l]) window.localStorage.setItem('scLang', REMAP[l]);
      return;
    }
  } catch (e) {}
})();
</script>

