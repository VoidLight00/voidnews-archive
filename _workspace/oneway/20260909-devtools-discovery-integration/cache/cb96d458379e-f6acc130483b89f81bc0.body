</script>
<style id="wf-i18n-wrap">html:not([lang^="en"]) .framer-text{overflow-wrap:break-word;hyphens:none !important;-webkit-hyphens:none !important;word-break:normal !important;}</style>
<style id="wf-cjk-kinsoku">html[lang^="zh"] .framer-text, html[lang^="ja"] .framer-text { word-break: normal !important; line-break: strict !important; }</style>

<script>
(function () {
  var MIN = 30;
  function isIndustries() { return /^\/industries\//.test(location.pathname); }
  function textWidth(el) {
    try { var r = document.createRange(); r.selectNodeContents(el); return r.getBoundingClientRect().width; }
    catch (e) { return el.scrollWidth; }
  }
  function fit() {
    if (!isIndustries()) return;
    var h1 = document.querySelector('h1');
    if (!h1 || h1.querySelector('br')) return;
    var text = (h1.textContent || '').trim();
    if (!text) return;
    var parent = h1.parentElement;
    if (!parent) return;
    var pcs = getComputedStyle(parent);
    var avail = parent.clientWidth - parseFloat(pcs.paddingLeft || 0) - parseFloat(pcs.paddingRight || 0);
    if (!avail || avail < 40) return;
    avail = avail - Math.max(28, avail * 0.08); /* wf-gap-applied: breathing room so the title never touches the divider */
    if (!h1.dataset.wfBase) {
      h1.style.fontSize = '';
      h1.dataset.wfBase = String(parseFloat(getComputedStyle(h1).fontSize));
    }
    var base = parseFloat(h1.dataset.wfBase);
    if (!base) return;
    if (h1.dataset.wfKey === text + '|' + Math.round(avail) + '|' + base) return;
    h1.style.whiteSpace = 'nowrap';
    h1.style.fontSize = base + 'px';
    var size = base;
    var w = textWidth(h1);
    if (w > avail && w > 0) {
      size = Math.max(MIN, Math.floor(base * avail / w));
      h1.style.fontSize = size + 'px';
      var w2 = textWidth(h1);
      if (w2 > avail && w2 > 0 && size > MIN) {
        size = Math.max(MIN, Math.floor(size * avail / w2));
        h1.style.fontSize = size + 'px';
      }
    }
    if (textWidth(h1) > avail) { h1.style.whiteSpace = ''; }
    h1.dataset.wfKey = text + '|' + Math.round(avail) + '|' + base;
  }
  var queued = false;
  function schedule() {
    try { fit(); } catch (e) {}
    if (queued) return;
    queued = true;
    requestAnimationFrame(function () { queued = false; try { fit(); } catch (e) {} });
  }
  function watch() {
    var h1 = document.querySelector('h1');
    if (h1 && !h1.__wfFitObs) {
      h1.__wfFitObs = new MutationObserver(function () { delete h1.dataset.wfKey; schedule(); });
      h1.__wfFitObs.observe(h1, { childList: true, subtree: true, characterData: true });
    }
    schedule();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watch);
  else watch();
  window.addEventListener('resize', function () { var h1 = document.querySelector('h1'); if (h1) delete h1.dataset.wfKey; schedule(); });
  window.addEventListener('load', watch);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) { var h1 = document.querySelector('h1'); if (h1) delete h1.dataset.wfKey; watch(); } });
  setInterval(watch, 1500);
})();
</script>

<script>
(function () {
  function isTranslated() { return !/^en/i.test(document.documentElement.lang || 'en'); }
  function apply() {
    if (!isTranslated()) return;
    var els = document.querySelectorAll('p, h1, h2, h3, h4');
    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      if (el.dataset.wfBal) continue;
      var cs = getComputedStyle(el);
      if (cs.textAlign !== 'center') continue;
      if (parseFloat(cs.fontSize) < 24) continue;
      var t = (el.textContent || '').trim();
      if (t.length < 40) continue;
      if (cs.whiteSpace === 'nowrap') continue;
      el.style.textWrap = 'balance';
      el.dataset.wfBal = '1';
    }
  }
  function cleanupGhosts() {
    if (!isTranslated()) return;
    var spans = document.querySelectorAll('span[style*="will-change"]');
    for (var i = 0; i < spans.length; i++) {
      var s = spans[i];
      if ((s.textContent || '').trim()) continue;
      if (s.dataset.wfGhost) continue;
      s.style.display = 'none';
      s.style.margin = '0';
      s.dataset.wfGhost = '1';
    }
  }
  function frenchSpaces() {
    if (!/^fr/i.test(document.documentElement.lang || '')) return;
    var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null);
    while (w.nextNode()) {
      var n = w.currentNode, p = n.parentElement;
      if (!p || p.tagName === 'SCRIPT' || p.tagName === 'STYLE') continue;
      if (/ [:;!?\u00BB]/.test(n.nodeValue)) n.nodeValue = n.nodeValue.replace(/ ([:;!?\u00BB])/g, '\u00A0$1');
    }
  }
  function run() { try { cleanupGhosts(); } catch (e) {} try { apply(); } catch (e) {} }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();
  window.addEventListener('load', run);
  window.addEventListener('resize', run);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) run(); });
  setInterval(run, 2000);
})();
</script>



<script>
(function () {
  function fit() {
    if (/^en/i.test(document.documentElement.lang || '')) return;
    var els = document.querySelectorAll('a, button');
    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      var cs = getComputedStyle(el);
      if (cs.overflow !== 'hidden') continue;
      var r = el.getBoundingClientRect();
      if (!r.width || !r.height || r.height > 200) continue;
      var p = el.querySelector('p') || el;
      var padX = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0);
      var need = p.scrollWidth + padX;
      if (need - r.width < 2) { if (el.dataset.wfFit) { el.style.minWidth = ''; delete el.dataset.wfFit; } continue; }
      var parent = el.parentElement;
      var parentW = parent ? parent.getBoundingClientRect().width : need;
      if (need <= parentW + 1) {
        el.style.minWidth = Math.ceil(need) + 'px';
      } else {
        el.style.overflow = 'visible';
        p.style.whiteSpace = 'normal';
      }
      el.dataset.wfFit = '1';
    }
  }
  function run() { try { fit(); } catch (e) {} }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();
  window.addEventListener('load', run);
  window.addEventListener('resize', run);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) run(); });
  setInterval(run, 2000);
})();
</script>



<script>
(function () {
  var lang = (document.documentElement.lang || '').toLowerCase();
  var fam = /^ja/.test(lang) ? 'Noto Sans JP' : (/^zh-hant/.test(lang) ? 'Noto Sans TC' : (/^zh/.test(lang) ? 'Noto Sans SC' : null));
  if (!fam) return;
  var href = 'https://fonts.googleapis.com/css2?family=' + fam.replace(/ /g, '+') + ':wght@300;400;500&display=swap';
  if (!document.querySelector('link[data-wf-cjk-font]')) {
    var pre = document.createElement('link');
    pre.rel = 'preconnect'; pre.href = 'https://fonts.gstatic.com'; pre.crossOrigin = '';
    document.head.appendChild(pre);
    var link = document.createElement('link');
    link.rel = 'stylesheet'; link.href = href; link.setAttribute('data-wf-cjk-font', '1');
    document.head.appendChild(link);
  }
  function apply() {
    try {
      var els = document.querySelectorAll('h1,h2,h3,h4,h5,h6,p,li,blockquote,em,strong');
      for (var i = 0; i < els.length; i++) {
        var e = els[i];
        if (e.dataset.wfCjk) continue;
        if (!(e.textContent || '').trim()) continue;
        var cs = getComputedStyle(e).fontFamily;
        if (!cs || cs.indexOf(fam) !== -1) { e.dataset.wfCjk = '1'; continue; }
        e.style.fontFamily = cs + ', "' + fam + '"';
        e.dataset.wfCjk = '1';
      }
    } catch (err) {}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);
  else apply();
  window.addEventListener('load', apply);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) apply(); });
  setInterval(apply, 2000);
})();
</script>

<script>
(function () {
  function localeFor() {
    var l = document.documentElement.getAttribute('lang') || 'en';
    // Pin Arabic numerals: bare 'ar' resolves to Latin or Arabic-Indic digits depending on the
    // device's ICU version, which would make dates look different per visitor. Force Latin.
    // Swap to 'ar-u-nu-arab' if Arabic-Indic (٢٠٢٦) is preferred.
    if (/^ar\b/i.test(l)) return 'ar-u-nu-latn';
    return l;
  }
  var cache = {};
  function formatter(l) {
    if (l in cache) return cache[l];
    try {
      cache[l] = new Intl.DateTimeFormat(l, { year: 'numeric', month: 'short', day: 'numeric' });
    } catch (e) { cache[l] = null; }
    return cache[l];
  }
  function apply() {
    var l = localeFor();
    if (/^en\b/i.test(l)) return;
    var f = formatter(l);
    if (!f) return;
    var nodes = document.querySelectorAll('time[datetime]');
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      if (el.getAttribute('data-wf-date') === l) continue;
      if (el.children.length) continue;
      var raw = el.getAttribute('datetime');
      var d = new Date(raw);
      if (!raw || isNaN(d.getTime())) continue;
      var txt;
      try { txt = f.format(d); } catch (e) { continue; }
      if (txt && el.textContent !== txt) el.textContent = txt;
      el.setAttribute('data-wf-date', l);
    }
  }
  var queued = false;
  function schedule() {
    if (queued) return;
    queued = true;
    setTimeout(function () { queued = false; apply(); }, 60);
  }
  function start() {
    apply();
    try {
      new MutationObserver(schedule).observe(document.documentElement, {
        childList: true, subtree: true, attributes: true, attributeFilter: ['lang', 'datetime']
      });
    } catch (e) {}
    var n = 0;
    var t = setInterval(function () { n++; apply(); if (n > 40) clearInterval(t); }, 500);
    document.addEventListener('visibilitychange', schedule);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>

