    if (span) { var c = MAP[span.textContent.trim()]; if (c && span.textContent !== c) span.textContent = c; }
    var items = Array.prototype.slice.call(sr.querySelectorAll('.scLangItem'));
    var counts = {};
    items.forEach(function (i) { var orig = i.getAttribute('data-wf-name') || i.textContent.trim(); var c = MAP[orig]; if (c) counts[c] = (counts[c] || 0) + 1; });
    items.forEach(function (i) {
      var orig = i.getAttribute('data-wf-name') || i.textContent.trim();
      i.setAttribute('data-wf-name', orig);
      var c = MAP[orig];
