    var hidden = panel.classList.contains('hidden');
    if (hidden) { panel.style.visibility = 'hidden'; panel.style.display = 'grid'; }
    var w = Math.ceil(panel.getBoundingClientRect().width);
    if (hidden) { panel.style.display = ''; panel.style.visibility = ''; }
    if (w > 0) host.style.setProperty('--wf-chip-w', w + 'px');
