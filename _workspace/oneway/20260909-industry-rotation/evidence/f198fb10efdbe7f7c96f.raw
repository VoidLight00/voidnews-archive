ent se-text se-l-default\" id=\"SE-4b4a81f5-96a3-4a2b-8d5d-a84be4d7542d\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-center \" style=\"\" id=\"SE-2375894c-8874-4e83-a7c4-f13fd8a4e1f4\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-10219a25-3677-46fc-960e-d65418fee483\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-center \" style=\"\" id=\"SE-2611dc99-c2bf-430e-886e-bdac2ec8e197\">\u003Cspan style=\"color:#00b050;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-221de6d8-870b-468d-b700-01be14ce9092\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-4b4a81f5-96a3-4a2b-8d5d-a84be4d7542d\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>                \u003Cdiv class=\"se-component se-image se-l-default\" id=\"SE-84cde92e-1ddb-4311-95e5-d06042607762\">\n                    \u003Cdiv class=\"se-component-content se-component-content-fit\">\n                        \u003Cdiv class=\"se-section se-section-image se-l-default se-section-align-center\" >\n                                \u003Cdiv class=\"se-module se-module-image\" style=\"\">\n                                    \u003Ca href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-84cde92e-1ddb-4311-95e5-d06042607762\", \"src\" : \"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDRfMjkz/MDAxNzg4NTA5MTQyNTQy.K48a4rETUau9Io_1DdGBqUjEzXAPwzTZ-ybUVbqzF1og.vLMjSXwQuMddSMGBx5Vm3ZeB3tMjwKEhKmWYxEQ8nXAg.JPEG/%EC%82%AC%EC%A7%842.jpg\", \"originalWidth\" : \"1567\", \"originalHeight\" : \"1045\", \"linkUse\" : \"false\", \"link\" : \"\", \"fileSize\": \"127821\" }'>\n                                        \u003Cimg src=\"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDRfMjkz/MDAxNzg4NTA5MTQyNTQy.K48a4rETUau9Io_1DdGBqUjEzXAPwzTZ-ybUVbqzF1og.vLMjSXwQuMddSMGBx5Vm3ZeB3tMjwKEhKmWYxEQ8nXAg.JPEG/%EC%82%AC%EC%A7%842.jpg\" alt=\"\" class=\"se-image-resource\" />\n                                    \u003C/a>\n                                \u003C/div>\n                            \u003Cdiv class=\"se-module se-module-text se-caption\">\u003Cp class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4c98837f-0c9d-49bc-9b60-fd336fad6108\">\u003Cspan style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-76f96e73-b390-45b1-a715-2efa0f22f73c\">[사진] 3일 경기도 성남시에 위치한 네이버 1784를 방문한 브루스 플랫 브룩필드 코퍼레이션 회장과 박준우 브룩필드코리아 대표가 네이버 제2사옥 ‘1784’를 둘러보고 있다.\u003C/span>\u003C/p>\n\u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-84cde92e-1ddb-4311-95e5-d06042607762\", \"data\": {\"ctype\": \"image\", \"ai\": \"false\", \"fileSize\": \"127821\" }}'>\u003C/script>\n                \u003C/div>\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-7c8cbfd0-d77a-4215-a3ae-57b1eae7f94b\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-113b65e8-6c19-4315-86fb-6099ce943647\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-a02d203c-1854-4a6e-a119-583ed7277a26\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-c46b1334-3f54-4830-b844-709495226bb5\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b3f22b78-5205-4756-9a97-e0f906e0f399\">네이버 이해진 의장과 브룩필드자산운용 브루스 플랫(Bruce Flatt) 회장이 3일 네이버 1784 사옥에서 만나 1GW급 AI 팩토리 사업에 대한 후속 논의를 진행했다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-d5678f7d-53fa-41eb-abfb-7bf91f1bbf37\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-16abace3-3ead-4b1f-a6d0-1b6c96639753\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-c98e846c-b2eb-46d1-9fa9-2d91494ce1d3\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-0fe1c765-1d9a-43e7-af58-d3b7fdbea8f2\">이해진 의장은 브룩필드가 과감한 투자 결정으로 네이버의 AI팩토리 사업 비전을 뒷받침해준 것에 감사를 표하며, 인프라 투자 분야에서 축적된 브룩필드의 역량과 네이버의 AI 기술력을 공고하게 결합하여 양사가 글로벌 AI인프라 시장을 선도해 가길 기대한다고 밝혔다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-17718f10-7ad7-4d56-9335-8bdda3116eb5\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-de966c99-8027-4aba-9366-4bd11dccc7af\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-02b9555c-0966-47da-aec9-4fb140181eea\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-25265062-8b1c-4b0b-b03c-a07f6594261b\">브루스 플랫 회장은 AI 팩토리 구축 사업의 자본 파트너로 브룩필드를 택해준 것에 감사 인사를 전하면서, 브룩필드가 단순히 자본 투자자 역할에 그치지 않고 장비 및 인프라의 효율적 조달과 고객 유치 등 사업 전반에 실질적 도움을 주는 파트너가 되겠다고 말했다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-8d1c180b-5dab-40e1-958c-fc86daa0ac7a\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-b152a342-30a0-4cb4-bc36-14c4fdc5bb90\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-a06bac5b-2f3f-4960-beec-3a8c696b5d7f\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-f4533265-6e3e-4bec-9044-dd23442a98c3\">브룩필드는 전세계에서 1조 달러 이상의 자산을 운용하는 글로벌 대체자산 운용사로, 네이버와 엔비디아의 1GW급 AI 팩토리 구축 사업 중 1단계(200MW)에 최대 90억 달러를 투입하기로 했다. 브룩필드는 이번 1단계 파이낸싱을 시작으로 향후 단계에서도 파트너십을 이어갈 계획이다. (끝)\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-7c8cbfd0-d77a-4215-a3ae-57b1eae7f94b\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>    \u003C/div>\n\u003C/div>\n\u003C/div>\n\u003Cimg src=\"https://www.navercorp.com/img/favicon.ico\" style=\"width: 0px; height: 0px; visibility: hidden;\" onload=\"loadSeViewer('real');\" />",json:null,tnUrl:"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDRfMTk1/MDAxNzg4NTA5MTcxOTUx.1CkilsBd27lMLG6jePO6CRQ8XeaWB65UNqH5mo-iixcg.10Nwk70L4ChjPQ52vgAPOpkJHUtVDc3npuuv0FKhEeIg.JPEG/%EC%82%AC%EC%A7%841.jpg?type=w480",tnDesc:null,tnBgColor:null,noticeYmd:"20260904",prev:{articleId:10034636,boardMetaId:"news",headline:null,title:"네이버, 7일부터 추석 쇼핑 프로모션 ... 명절 선물 세트부터 귀성길 필수템까지 풍성",content:"\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://editor-static.pstatic.net/v/basic/1.76.0/css/se.viewer.desktop.css\">\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://static-homepage.pstatic.net/cdn-static/smart-editor/homepage_seviewer.css?20260909\">\n\u003Cdiv id=\"one-viewer\" class=\"one-viewer se_one_viewer_wrapper_880\">\u003Cdiv class=\"se-viewer se-theme-default\" lang=\"ko-KR\">\n    \u003C!-- SE_DOC_HEADER_START -->\n    \u003C!--@CONTENTS_HEADER-->\n    \u003C!-- SE_DOC_HEADER_END -->\n    \u003Cdiv class=\"se-main-container\">\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-732eb254-3d88-457a-9dc1-8a59d9030989\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-5159972a-9665-44ab-8fc4-d2cd7c514cc2\">\u003Cspan style=\"color:#00b050;\" class=\"se-fs-fs30 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-c7d97ed9-5fb6-409a-953c-a21b176cf20c\">\u003Cb>네이버, 7일부터 추석 쇼핑 프로모션 ... 명절 선물 세트부터 귀성길 필수템까지 풍성\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-592efe8c-3aa8-41ed-ba02-db6afd8dc589\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-03a3448c-59ec-47f0-95e8-b361b4750fc4\">\u003Cb>- 네이버플러스 스토어 단독 기획 선물 세트를 매일 오전 11시 특가로 ... 가격대별·상황별 선물 제안도\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-4db3ac39-93c8-4847-9826-1750f702d46e\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-29ac1f22-4a79-4450-a0ca-70628040bfaf\">\u003Cb>- 빠르고 안정적인 N배송 상품 알뜰히 모아 ... 네플스 앱에서 매일 오전 10시 선착순 할인 쿠폰 제공도\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-2b108212-dfee-48e5-a295-47f9eadb1b67\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-663d7e05-a4f6-4416-97d9-eb1866852a53\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-right \" style=\"\" id=\"SE-96bf8238-a655-44b9-8004-e03787586c34\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-c3ecbc62-4bd4-4b50-bcee-2b63e255fd61\">2026-09-07\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-9210d7ad-9428-4f1b-b115-758890479c02\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-01afd56d-397e-451e-a862-17090b5294fe\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b6510f69-e8f0-406d-82ae-705365edb584\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-de2c5a77-63d0-42a9-84a3-a9eb26cf985d\">네이버(주)(대표이사 최수연)가 추석 명절을 맞아 네이버플러스 스토어(이하 네플스)에서 ‘추석+세일’ 프로모션을 연다. 7일부터 22일까지 총 16일간 진행하는 이번 행사에는 1만여개의 대표 브랜드사가 참여해, 추석맞이 인기 선물 세트와 차례상 준비를 위한 식품, 귀성길 필수템 등 다양한 상품을 소개한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-2dc03859-492d-4c70-a987-6282ad8a2930\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-ddf746c6-2428-4988-a6fa-bced10b0b787\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-732eb254-3d88-457a-9dc1-8a59d9030989\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>                \u003Cdiv class=\"se-component se-image se-l-default\" id=\"SE-df512043-5865-4fb1-968d-bad18e4e02b0\">\n                    \u003Cdiv class=\"se-component-content se-component-content-extend\">\n                        \u003Cdiv class=\"se-section se-section-image se-l-default se-section-align-center\" >\n                                \u003Cdiv class=\"se-module se-module-image\" style=\"\">\n                                    \u003Ca href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-df512043-5865-4fb1-968d-bad18e4e02b0\", \"src\" : \"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDdfMTkw/MDAxNzg4NzQzNTYwOTY1.oQTmhDdVTHnPSHMM7k9cYSD57HLnnp9oOMu2mY-hzM4g.2EzKmey3qcDV-lbxdK6Bv0iM6wrhL78D-Laj6bNDSN0g.PNG/%EC%9D%B4%EB%AF%B8%EC%A7%80_%EB%84%A4%EC%9D%B4%EB%B2%84,_7%EC%9D%BC%EB%B6%80%ED%84%B0_%EC%B6%94%EC%84%9D_%EC%87%BC%ED%95%91_%ED%94%84%EB%A1%9C%EB%AA%A8%EC%85%98_..._%EB%AA%85%EC%A0%88_%EC%84%A0%EB%AC%BC_%EC%84%B8%ED%8A%B8%EB%B6%80%ED%84%B0_%EA%B7%80%EC%84%B1%EA%B8%B8_%ED%95%84%EC%88%98%ED%85%9C%EA%B9%8C%EC%A7%80_%ED%92%8D%EC%84%B1.png\", \"originalWidth\" : \"850\", \"originalHeight\" : \"450\", \"linkUse\" : \"false\", \"link\" : \"\", \"fileSize\": \"441637\" }'>\n                                        \u003Cimg src=\"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDdfMTkw/MDAxNzg4NzQzNTYwOTY1.oQTmhDdVTHnPSHMM7k9cYSD57HLnnp9oOMu2mY-hzM4g.2EzKmey3qcDV-lbxdK6Bv0iM6wrhL78D-Laj6bNDSN0g.PNG/%EC%9D%B4%EB%AF%B8%EC%A7%80_%EB%84%A4%EC%9D%B4%EB%B2%84,_7%EC%9D%BC%EB%B6%80%ED%84%B0_%EC%B6%94%EC%84%9D_%EC%87%BC%ED%95%91_%ED%94%84%EB%A1%9C%EB%AA%A8%EC%85%98_..._%EB%AA%85%EC%A0%88_%EC%84%A0%EB%AC%BC_%EC%84%B8%ED%8A%B8%EB%B6%80%ED%84%B0_%EA%B7%80%EC%84%B1%EA%B8%B8_%ED%95%84%EC%88%98%ED%85%9C%EA%B9%8C%EC%A7%80_%ED%92%8D%EC%84%B1.png\" alt=\"\" class=\"se-image-resource\" />\n                                    \u003C/a>\n                                \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-df512043-5865-4fb1-968d-bad18e4e02b0\", \"data\": {\"ctype\": \"image\", \"ai\": \"false\", \"fileSize\": \"441637\" }}'>\u003C/script>\n                \u003C/div>\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-7d050ef3-36b0-432f-9126-cd8b32a047c5\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b65245ad-5a86-4264-9a94-f1f2e6e24121\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-d5b13837-8498-4f6e-bb0e-5992549dae09\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-a7332548-5094-4f19-a331-b4b560a7736d\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-995ad46b-6760-4368-9ec8-768a0e95411d\">특히, ‘추석 선물’ 코너에서는 네플스에서만 단독 구매할 수 있는 한우 세트, 영양제, 전통과자, 스팸·참치 세트 등 기획 선물을 매일 오전 11시 특가로 선보인다. 추석 전용 대량구매 전용관에서는 단체 선물을 준비하는 이용자를 위해 ‘CJ제일제당’, ‘동원’, ‘청정원’ 등 인기 브랜드의 상품을 모았다.  \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-0fd2e0c3-d2b7-4107-8cc3-ad36fb2f7e84\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-f3d9e0dc-7869-4480-9236-72f7b04c2fad\">또한, 이용자들이 선물 목적에 맞는 구성을 손쉽게 찾을 수 있도록 1-2만원 · 3-4만원 · 5-9만원 이상 등 가격대별 상품과, 부모님 · 아이 · 연인 등 대상별 상품을 함께 큐레이션할 예정이다. 이외에도 뷰티·건강식품 등 다양한 카테고리에 걸쳐 ‘에스티로더’, ‘설화수’, ‘바디프랜드, ‘필립스’ 등 남녀노소가 두루 선호하는 브랜드들의 상품을 만나볼 수 있다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-c1bfa1c6-4ffd-454c-ba77-9e16adf66ed7\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-fc7a21c5-5db0-42fc-a68a-356d461c2280\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-36ac5483-79a6-4519-8328-3737a83b0a80\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-92ac81d1-6ebd-4a34-817f-dbc3e6e32d53\">‘추석준비관’에서는 떡·한과·보양식, 한복, 그릇세트 등 명절을 위한 상품들을 둘러볼 수 있다. 나흘간 이어지는 연휴인만큼 가족과 함께 시간을 보내려는 이용자들을 위한 외식 상품권과 테마파크·액티비티 등 여행 상품도 해당 코너에 다채롭게 마련했다. 이와 함께 연휴 동안 온전한 휴식을 즐기는 이용자를 위한 간편식과 디지털·가전 제품, 귀성길에 필수적인 차량 용품과 펫 용품 등도 합리적인 가격대로 선보인다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-52a94941-515a-4407-90ab-6f6685eb53a3\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-298e78ba-de7c-4e99-b046-e3596800463f\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-491972a3-c3a9-4fd6-84d6-f4125f6c04c6\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b05c7bbe-5f3f-415a-aac5-78f09f177193\">여기에 더해 네이버플러스 멤버십 전용 혜택도 준비되어 있다. 멤버십 이용자라면, 매일 오전 10시 네플스 앱에서 1만원 이상 구매 시 사용할 수 있는 10% 할인 쿠폰 등을 선착순으로 다운받을 수 있다. 또한, 멤버십데이인 14일(월)에는 하루 동안 네이버페이 포인트 3% 추가적립 혜택도 제공한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-ea5a9e95-bbdc-464b-8b76-cf1cb217fd08\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-e8b4c2b6-24db-432d-a9b1-9ff910199f02\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-c5d6a456-ed2a-4db4-8e8b-0a9f3950178a\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-a50d475e-98f0-41a1-af33-0f38980c1656\">한편, 네이버는 연휴 기간에도 끊김 없는 N배송 경험을 제공한다. 이번 ‘추석+세일’에서 선보이는 신선식품과 건강식품, 생필품, 패션 등 다양한 상품들은 N배송으로 받아볼 수 있다. 이어 23일부터 27일까지 5일간 휴일에도 안정적으로 받을 수 있는 N배송 상품을 모아 ‘네이버배송은 연휴에도 배송’ 프로모션을 진행할 예정이다. (끝)\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-339e2eea-1ca8-447d-8939-70a504d457d6\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-fce19712-e437-4e23-9b63-f6147b9acd26\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-7d050ef3-36b0-432f-9126-cd8b32a047c5\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>    \u003C/div>\n\u003C/div>\n\u003C/div>\n\u003Cimg src=\"https://www.navercorp.com/img/favicon.ico\" style=\"width: 0px; height: 0px; visibility: hidden;\" onload=\"loadSeViewer('real');\" />",json:null,tnUrl:"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDdfMTgg/MDAxNzg4NzQzNTcyODk1.dYEiRMV5bZEpRdwYcSZ1w3k1vtQDsrSQ9cJqXaPsct4g.fFatkzpl9YbJkcbgETbupa7lct-jYrReh_xL9y9mco4g.PNG/%EC%9D%B4%EB%AF%B8%EC%A7%80_%EB%84%A4%EC%9D%B4%EB%B2%84%2C_7%EC%9D%BC%EB%B6%80%ED%84%B0_%EC%B6%94%EC%84%9D_%EC%87%BC%ED%95%91_%ED%94%84%EB%A1%9C%EB%AA%A8%EC%85%98_..._%EB%AA%85%EC%A0%88_%EC%84%A0%EB%AC%BC_%EC%84%B8%ED%8A%B8%EB%B6%80%ED%84%B0_%EA%B7%80.png?type=w480",tnDesc:null,tnBgColor:null,noticeYmd:"20260907",prev:null,next:null,fileList:[],factsheet:null,mainImgUrl:null,keywordList:[],relatedUrl:null,category:null,categoryNm:null,vodOption:null,imageList:[],period:null,author:null,contentsTextYn:"Y",contentsImageYn:"Y",pid:null,nid:null},next:{articleId:10034633,boardMetaId:"news",headline:null,title:"네이버, 네이버플러스 멤버십 이용자 전용 오프라인 페스티벌 연다",content:"\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://editor-static.pstatic.net/v/basic/1.76.0/css/se.viewer.desktop.css\">\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://static-homepage.pstatic.net/cdn-static/smart-editor/homepage_seviewer.css?20260909\">\n\u003Cdiv id=\"one-viewer\" class=\"one-viewer se_one_viewer_wrapper_880\">\u003Cdiv class=\"se-viewer se-theme-default\" lang=\"ko-KR\">\n    \u003C!-- SE_DOC_HEADER_START -->\n    \u003C!--@CONTENTS_HEADER-->\n    \u003C!-- SE_DOC_HEADER_END -->\n    \u003Cdiv class=\"se-main-container\">\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-59bc5bee-0387-41f9-8888-2900ed3e7b2e\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-825b2114-cc56-4d71-9490-f4d420ba1a1c\">\u003Cspan style=\"color:#00b050;\" class=\"se-fs-fs24 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b8a6303c-060e-4c10-ae1f-0f7ae7f0ad1c\">\u003Cb>“넾페스타에서는 모든 순간이 혜택”\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-3b08f2b3-8dd5-45c5-bb23-70012375c08b\">\u003Cspan style=\"color:#00b050;\" class=\"se-fs-fs30 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-05d2bce2-1f75-43f7-9563-ae9a6c4b4f79\">\u003Cb>네이버, 네이버플러스 멤버십 이용자 전용 오프라인 페스티벌 연다\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-39805eab-483b-49a5-9307-8b8667ab6f52\">\u003Cspan style=\"color:#000000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-685a9d5a-6f22-4595-8587-6c401b9d0721\">\u003Cb>- &#x27;Npay 페이스사인&#x27; 기반 입장부터 F&amp;B·굿즈 결제까지, &#x27;Npay 월렛 NFT&#x27; 스탬프 투어 진행\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-569ca9eb-b431-423d-bf83-1dbd9aa6791e\">\u003Cspan style=\"color:#000000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-decff0f1-e90d-419d-99dd-7999f445646a\">\u003Cb>- 멤버십 이용자 10월 6일(화) 선예매 오픈…2030 타겟 네이버 브랜드, 기술력 경험 제공\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-762ba2ae-e158-4f54-99ee-bca3a17cbefd\">\u003Cspan style=\"color:#ff0000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-f164e384-b3a5-4724-83f1-c10e8ed31afd\">\u003Cb> \u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-right \" style=\"\" id=\"SE-00105864-343e-4c48-9bb6-712f90f5eaf1\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-ffca5e41-f006-4ff3-b13b-60f400bcebd6\">2026-09-04\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-0eccbdc6-4fa9-4d3f-9bd0-c4fe6ee92793\">\u003Cspan style=\"color:#ff0000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-a3c635a6-e1f4-414c-87d9-7ffa2ed06f7a\">\u003Cb> \u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-4277d924-3b99-43a5-ab9c-a2447f17b114\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-dd08052e-0866-47f0-bea6-cbca891d73e7\">네이버㈜(대표이사 최수연)가 네이버플러스 멤버십 이용자를 위한 오프라인 페스티벌 ‘넾페스타’를 10월 30일(금)부터 11월 1일(일)까지 앤더슨씨 성수에서 개최한다고 밝혔다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-5fc130f2-2332-42c9-a52b-c086e4f63d4d\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-556cfb1a-a24f-4553-b9fa-0685fdb879a6\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7dd5c2a3-60eb-4d6e-811d-d15d3356e049\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-0c19d202-85bd-4cf5-8c27-dc18d003e3b0\">‘넾페스타’는 예약, 출입인증, 결제, NFT까지 네이버의 다양한 기술력이 접목된 네이버만의 쇼핑문화 음악공연이다. 네이버는 네이버플러스 멤버십 이용자들에게 네이버의 기술, 서비스로 온오프라인을 연계한 새로운 경험을 제공하기 위해 이번 이벤트를 준비했다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-f86dedfb-368e-4fb6-98c4-14b4169f5855\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-250de81d-123f-4adc-8d86-9d002c795a17\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b047fd4a-c233-40c0-98d4-cd4fd1175fcd\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b80499c1-8cac-48b3-9301-710e1e1d923b\">네이버는 ‘넾페스타’에 출연하는 아티스트 실리카겔, 루시, 자이언티, 카더가든, 권진아 및 쇼핑 참가 브랜드를 1차 공개했고, 순차적으로 쇼핑, 파트너존, F&amp;B 참가 브랜드, 아티스트 전체 라인업, 스페셜 굿즈 등을 안내할 예정이다. 10월 6일 13시에 선예매를, 10월 7일에 일반 예매를 진행한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-bd966f15-cd1b-45b0-a0a4-00cf35cd577b\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-cc2f0ff8-d057-42fd-963d-0fbf2fcc8574\">(*네이버 멤버십 이용자 대상으로 예매를 진행하며, 9월 4일부터 10월 5일까지 Npay로 20만원 이상 결제 시 선예매 혜택 제공)\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b5a1c796-b337-444e-9489-83143cf1f567\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-1708b72e-44e0-4383-84c9-f44345a948a2\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7ce39aae-689f-476f-815f-6a163745b8fd\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-a4153db5-96bb-441e-9dac-ce1db6f1976c\">‘넾페스타’ 현장은 Npay 페이스사인(Facesign)으로 더욱 빠르고 안전한 입장 경험을 제공할 예정이다. 페이스사인은 네이버가 자체 개발한 딥러닝 기반 얼굴 인식 모델로, 워크스루(walk-thru) 방식의 빠른 인증은 물론 안티스푸핑(anti-spoofing) 기술과 양자내성암호(PQC)가 적용되어 얼굴정보를 안전하게 보관·운영한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-2d23e756-2afe-4334-a885-c42e826322df\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-15481d7f-4b43-4889-9593-734b38eb072f\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-5bc69a12-f2e3-495b-b102-3d08d21fbf4a\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-2f023c3a-c615-42b2-82d0-fa74f4f104fe\">또한 현장에서는 Npay 월렛 기반으로 영구 소장 가능한 형태의 NFT 스탬프 투어 이벤트를 통해 디지털 기반의 새로운 관람 경험을 제공할 계획이다. &#x27;Npay 월렛&#x27;은 네이버 아이디를 기반으로 누구나 쉽게 이용할 수 있는 Web3 디지털 자산 지갑 서비스로, 티켓과 같은 디지털 자산을 안전하게 보관·관리해 티켓의 위·변조와 부정 거래를 방지하는 데 기여한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b83d92d8-b71e-4cb1-b473-e8deeb2e4b1c\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-e1573345-ec36-40ba-98a6-5a7b77f6edb5\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-083f9f31-37d7-4fc0-9c75-3b2be7fb44a2\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-0e8ef1a6-0e84-4fd9-925c-973edf5a2b28\">아울러 ‘넾페스타’에 입점한 다양한 브랜드 존에서 오프라인 통합 단말기 &#x27;Npay 커넥트&#x27;를 통한 페이스사인 결제까지 가능해 네이버의 혁신적인 브랜드 경험을 제공한다. 행사 기간 중에는 성수 지역 내 &#x27;Npay 커넥트&#x27; 도입 매장을 대상으로 별도 프로모션도 함께 운영된다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-147ecc07-35bb-40a1-b090-0d367bb97045\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-f24ec8d8-df93-4648-a39b-304bb74f6161\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-196a01bf-b00a-48e2-9d85-899b8b0cc62b\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-1408ad5a-4453-4078-bb38-d3e1eaf99c1d\">또한 네이버 브랜드스토어에 입점한 뷰티, 라이프스타일, 푸드 등 다양한 브랜드를 소개하고 체험할 수 있는 공간도 마련한다. 네이버플러스 스토어 주요 브랜드사들은 특별 부스를 운영해 입장객 전원에게 한정 굿즈를 제공하며 네이버 멤버십 고객 중심의 차별적인 쇼핑 경험을 선사한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-ba0f409f-6604-4730-837e-568ab5665557\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-9ff0db6c-2c87-4f5b-8ea2-0f35747b2337\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-6e758f0e-9f59-4fd5-90fd-81ff3f993276\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-a9379518-624a-49f6-9ceb-b0bdf70054c0\">네이버 브랜드 경험 심준용 리더는 “네이버의 쇼핑, 예약, 결제 등 전사적 역량을 결합한 오프라인 멤버십 페스티벌 ‘넾페스타’는 2030 이용자를 대상으로 아티스트 공연부터 브랜드 체험존까지 다양하게 준비했다”며 “향후에도 네이버의 온오프라인 생태계를 연결한 다양한 혁신적 이벤트를 선보이겠다”라고 밝혔다. (끝)\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-e7c2ccbc-6bc2-4cc8-b23d-e5c4d1ff94e2\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-8a011327-23b2-497c-afdd-27a636b14806\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-59bc5bee-0387-41f9-8888-2900ed3e7b2e\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>                \u003Cdiv class=\"se-component se-image se-l-default\" id=\"SE-ec0016d0-4053-4ac1-8361-2fd5df5a9a1b\">\n                    \u003Cdiv class=\"se-component-content se-component-content-fit\">\n                        \u003Cdiv class=\"se-section se-section-image se-l-default se-section-align-center\" >\n                                \u003Cdiv class=\"se-module se-module-image\" style=\"\">\n                                    \u003Ca href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-ec0016d0-4053-4ac1-8361-2fd5df5a9a1b\", \"src\" : \"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDRfMjUx/MDAxNzg4NDg4Mjg0ODk2.pZkRFTSk0sOqSoIjEYdIXfWHLwdZRTm6LLoVjbOVwG4g.nZEByyNDgsEcfcfD7fvInAn6W9jDOXSPyebmaBKWSNog.JPEG/%EB%84%BE%ED%8E%98%EC%8A%A4%ED%83%80.jpg\", \"originalWidth\" : \"1080\", \"originalHeight\" : \"720\", \"linkUse\" : \"false\", \"link\" : \"\", \"fileSize\": \"194112\" }'>\n                                        \u003Cimg src=\"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDRfMjUx/MDAxNzg4NDg4Mjg0ODk2.pZkRFTSk0sOqSoIjEYdIXfWHLwdZRTm6LLoVjbOVwG4g.nZEByyNDgsEcfcfD7fvInAn6W9jDOXSPyebmaBKWSNog.JPEG/%EB%84%BE%ED%8E%98%EC%8A%A4%ED%83%80.jpg\" alt=\"\" class=\"se-image-resource\" />\n                                    \u003C/a>\n                                \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-ec0016d0-4053-4ac1-8361-2fd5df5a9a1b\", \"data\": {\"ctype\": \"image\", \"ai\": \"false\", \"fileSize\": \"194112\" }}'>\u003C/script>\n                \u003C/div>\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-e4a83e23-6b0a-4a41-8f95-d71143e20514\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-center \" style=\"\" id=\"SE-0378a17c-c68d-497e-a96a-4fdf52c95155\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-84ddfe32-633a-43bb-ba8a-d7db3a71478e\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-e4a83e23-6b0a-4a41-8f95-d71143e20514\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>    \u003C/div>\n\u003C/div>\n\u003C/div>\n\u003Cimg src=\"https://www.navercorp.com/img/favicon.ico\" style=\"width: 0px; height: 0px; visibility: hidden;\" onload=\"loadSeViewer('real');\" />",json:null,tnUrl:"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDRfMzAg/MDAxNzg4NDg4MjU1NjY0.eulAYUMMV4lfdcdDWHJIFjE5xfSZ9lWo1ce_3RvApqQg.D3SE-jYynVGJtdrVGuy-5hcSwefNisWDNCDcsXEVn9Ug.JPEG/%EB%84%BE%ED%8E%98%EC%8A%A4%ED%83%80.jpg?type=w480",tnDesc:null,tnBgColor:null,noticeYmd:"20260904",prev:null,next:null,fileList:[],factsheet:null,mainImgUrl:null,keywordList:[],relatedUrl:null,category:null,categoryNm:null,vodOption:null,imageList:[],period:null,author:null,contentsTextYn:"Y",contentsImageYn:"Y",pid:null,nid:null},fileList:[],factsheet:null,mainImgUrl:null,keywordList:[],relatedUrl:null,category:null,categoryNm:null,vodOption:null,imageList:[],period:null,author:null,contentsTextYn:"Y",contentsImageYn:"Y",pid:10034636,nid:10034633},related:[],headerTheme:"black",headerBackground:"transparent"},uses:{search_params:["seq"],parent:1}}],
							form: null,
