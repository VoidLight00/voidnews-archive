    window.OneTrustManager = (function () {
        function ensureAnalyticsLoaded() {
            if (document.getElementById("analyticsinit-newsroom-js")) return;
            var s = document.createElement("script");
            s.src = "https://download.amd.com/js/analytics/analyticsinit.js";
            s.id = "analyticsinit-newsroom-js";
            document.head.appendChild(s);
        }

        async function openCookieSettings() {
            ensureAnalyticsLoaded();

            const maxAttempts = 20;
            let attempts = 0;

            const tryOpen = () => {
                if (window.OneTrust && typeof window.OneTrust.ToggleInfoDisplay === "function") {
                    window.OneTrust.ToggleInfoDisplay();
                } else if (attempts < maxAttempts) {
                    attempts++;
                    setTimeout(tryOpen, 250);
                }
            };

            tryOpen();
        }

        return {
            openCookieSettings,
            get isLoaded() {
                return !!(window.OneTrust && typeof window.OneTrust.ToggleInfoDisplay === "function");
            },
        };
