            (function () {
                window.dataLayer = window.dataLayer || [];

                function parseSnapshot(cookieStr) {
                    var raw = cookieStr.split(/;\s*/).find(function (c) {
                        return c.indexOf("OptanonConsent=") === 0;
                    });
                    if (!raw) return null;
                    var decoded = raw.slice("OptanonConsent=".length);
                    try {
                        decoded = decodeURIComponent(decoded);
                    } catch (e) {}
                    var m = decoded.match(/groups=([^&]*)/);
                    if (!m) return {};
                    var groups = m[1];
                    try {
                        groups = decodeURIComponent(groups);
                    } catch (e) {}
                    var out = {};
                    groups.split(",").forEach(function (entry) {
                        var trimmed = entry.trim();
                        if (!trimmed) return;
                        var parts = trimmed.split(":");
                        var code = parts[0];
                        if (!code) return;
                        out[code] = parts[1] === "1";
                    });
                    return out;
                }

                function toGcm(snap) {
                    var c2 = snap["C0002"] === true;
                    var c3 = snap["C0003"] === true;
                    var c4 = snap["C0004"] === true;
                    return {
                        analytics_storage: c2 ? "granted" : "denied",
                        functionality_storage: c3 ? "granted" : "denied",
                        personalization_storage: c3 ? "granted" : "denied",
                        ad_storage: c4 ? "granted" : "denied",
                        ad_user_data: c4 ? "granted" : "denied",
                        ad_personalization: c4 ? "granted" : "denied",
                        security_storage: snap["C0001"] === false ? "denied" : "granted",
                    };
                }

                function diffSnaps(prev, next) {
                    var diff = {};
                    var codes = {};
                    Object.keys(prev || {}).forEach(function (k) {
                        codes[k] = true;
                    });
                    Object.keys(next).forEach(function (k) {
                        codes[k] = true;
                    });
                    Object.keys(codes).forEach(function (code) {
                        var from = (prev || {})[code] === true;
                        var to = next[code] === true;
                        if (from !== to) diff[code] = { from: from, to: to };
                    });
                    return diff;
                }

                var lastSnapshot = null;

                function activeGroupCodes(snap) {
                    return Object.keys(snap).filter(function (code) {
                        return snap[code] === true;
                    });
                }

                function notifyConsentListeners(snap) {
                    if (snap === null) return;
                    window.dispatchEvent(
                        new CustomEvent("OneTrustGroupsUpdated", {
                            detail: activeGroupCodes(snap),
                        }),
                    );
                }

                function emit(eventName) {
                    var snap = parseSnapshot(document.cookie);
                    if (snap === null) return;
                    var diff = diffSnaps(lastSnapshot, snap);
                    if (lastSnapshot !== null && Object.keys(diff).length === 0) return;
                    window.dataLayer.push({
                        event: eventName,
                        consent: toGcm(snap),
                        onetrust_groups: snap,
                        consent_changed: diff,
                    });
                    lastSnapshot = snap;
                }

                emit("consent_default");

                window.OptanonWrapper = function () {
                    emit("consent_update");
                    notifyConsentListeners(parseSnapshot(document.cookie));
