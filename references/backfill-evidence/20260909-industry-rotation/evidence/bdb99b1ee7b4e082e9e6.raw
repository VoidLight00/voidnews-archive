					]).then(([kit, app]) => {
						kit.start(app, element, {
							node_ids: [0, 36],
							data: [{type:"data",data:{lang:"ko",storyCards:[{seq:10034642,title:" 100인의 크리에이터와 함께한 ‘네이버 AI 디깅클럽’ 1기 발대식 후기",category:"Service",date:"2026.09.07",thumbnailUrl:"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDdfMjYw/MDAxNzg4Nzc2NTYzODM3.0IkuzDuFbt4ZlE39VQwilghBez0rj7Otslv_rh-nH1kg.989t80qFU-oludLHCY4LTSyadn2JK7XEjl00PW1OakIg.JPEG/%EB%94%94%EA%B9%85%ED%81%B4%EB%9F%BD_%EA%B0%80%EB%A1%9C.jpg?type=w800"},{seq:10034596,title:"이해진 의장, 엔비디아·브룩필드와 AI 팩토리 공동 구축을 위한 초대형 협력 소식 발표",category:"Leader's View",date:"2026.07.24",thumbnailUrl:"https://corp-homepage-phinf.pstatic.net/MjAyNjA4MTNfMTQ3/MDAxNzg2NTk4ODY3Nzgy.ssme57PavwaMbx2p059S_drSf9H-vCtuuQyoaB43mvAg.EEAvfnRba1VPLezVS_Ma3Lk6RfRrcIpWz0ky18gCyBwg.PNG/%EB%B8%8C%EB%A3%A9%ED%95%84%EB%93%9C%EC%97%94%EB%B9%84%EB%94%94%EC%95%84_%EA%B0%80%EB%A1%9C%ED%98%95.png?type=w800"}]},uses:{}},{type:"data",data:{article:{articleId:10034628,boardMetaId:"news",headline:null,title:"네이버클라우드 컨소시엄, 국내 보안 환경 특화 AI 모델 만든다",content:"\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://editor-static.pstatic.net/v/basic/1.76.0/css/se.viewer.desktop.css\">\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://static-homepage.pstatic.net/cdn-static/smart-editor/homepage_seviewer.css?20260909\">\n\u003Cdiv id=\"one-viewer\" class=\"one-viewer se_one_viewer_wrapper_880\">\u003Cdiv class=\"se-viewer se-theme-default\" lang=\"ko-KR\">\n    \u003C!-- SE_DOC_HEADER_START -->\n    \u003C!--@CONTENTS_HEADER-->\n    \u003C!-- SE_DOC_HEADER_END -->\n    \u003Cdiv class=\"se-main-container\">\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-490e78d6-1951-4191-a151-912eff6c1db3\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-c9f06c3f-a4b2-4ca6-b51b-c3cbb4b455a3\">\u003Cspan style=\"color:#00b050;\" class=\"se-fs-fs30 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-0f397569-0263-4b03-8259-4c18aba1f9a9\">\u003Cb>네이버클라우드 컨소시엄, 국내 보안 환경 특화 AI 모델 만든다\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-aba53c1e-2712-473d-b33a-997ee2f07b0f\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-4d15db27-9e9b-400c-b99d-bf6ba14bde42\">\u003Cb>- 4,000장 GPU 선제 투입…하이퍼클로바X·엑사원 모델 활용해 700B급 2개 독자 보안모델 개발\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-ead964c4-d356-4a22-9410-20a4e5a86e9a\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-9c2a7307-b158-46b9-adb4-6c4eb8edbc61\">\u003Cb>- 7대 전략산업·국가 핵심시설 실증…국가 보안 AI 생태계 확산 목표\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-right \" style=\"\" id=\"SE-4e9037f5-8c92-4d33-80dd-36a46e8193e9\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-42c702d7-a4c8-489a-938b-e964d5d1e65d\">2026-09-03\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-145c3afb-9727-41e5-ac63-d3d039b3b57f\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-06bf8477-32bb-42e8-aa83-33e7f19a6ded\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-d2893abd-462b-4af2-a625-e3099a3a5b4a\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-620c3c87-c242-4b78-bc11-61718cbd4ca3\">네이버클라우드 컨소시엄은 정부의 &#x27;특화 인공지능 파운데이션 모델 개발(사이버 보안 분야)’ 사업자로 최종 선정되어 본격적인 개발에 착수한다고 밝혔다. 해당 컨소시엄은 이번 사업을 통해 총 33개 산·학·연·공공기관이 힘을 모아 국내 보안 환경에 최적화된 AI 모델을 구축하고, 국가 핵심시설과 주요 산업 현장에서 검증 및 고도화를 추진해 국내 보안 AI 경쟁력을 한 단계 높인다는 계획이다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-95f360fe-6e32-40bc-80cc-4839a763fe35\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-953b4d9f-8a7c-4ac8-840f-18c27963c8e9\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-bedf73d5-a6fa-4019-9ba0-2f6e23999a68\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-e51e5e59-980f-469a-92b6-4b019264c59e\">특히 컨소시엄은 정식 사업 착수 전부터 보유 GPU 4,000장을 선제 투입해 보안 특화 AI 모델의 사전학습을 진행해왔다. 정부 제공 물량(256장)과 별개로 네이버클라우드의 B200 4,000장과 LG의 H200 256장을 추가 투입하는 구조다. 이러한 전폭적인 선제 투자를 바탕으로 개발 기간을 대폭 단축하는 한편, 확보한 시간을 모델 성능 고도화와 현장 실증에 집중 투입해 완성도를 극대화할 예정이다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-aedace15-bb3f-44d3-a9e2-64728b32c3c9\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-267f5f7b-6312-48c7-880b-884162f30f6b\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-27ab3b95-453e-4fe6-8a9a-fb0e4ebeb386\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-3ee6db5e-a6a0-4433-b45a-936b8fa62264\">이러한 대규모 인프라를 바탕으로 컨소시엄은 하이퍼클로바X와 엑사원을 기반으로 한 최종 700B급 MoE(전문가 혼합) 구조의 초거대 보안 특화 모델을 구축한다. 방어 역량(하이퍼클로바X)과 공격 역량(엑사원)을 각각 강화한 2개의 독자 모델을 병렬 개발해 공격·방어 전주기 대응력을 확보하고, 국제 공인 벤치마크 2종으로 객관적 성능을 엄격히 검증할 계획이다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-9fbb3919-2fc2-4e4c-8acc-f6edc32754f9\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-8d1ec14b-cab9-4b72-ba82-14bad824f5b8\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-d3f1f3f7-4dc6-481b-865a-b4fe4213ffda\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-f5dcd07e-51a6-489b-a655-6a552d5a41e1\">아울러 모델의 성능을 좌우하는 학습용 데이터는 단일 기관이 확보하기 어려운 약 830TB 규모의 고품질 실데이터를 활용한다. 네이버클라우드와 LG CNS의 운영 데이터는 물론 한전KDN·한국수력원자력·금융보안원·KISTI·LG유플러스 등 국가 기반시설과 주요 산업의 핵심 데이터를 총망라했다. 여기에 위협정보 수집부터 라벨링·표준화·검증으로 이어지는 데이터 정제 기술을 적용해 실제 위협 환경을 정밀하게 학습시킬 예정이다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7ca19481-41d7-46f3-be29-9be31361b3ef\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-e7086278-0d54-466b-8cb7-95d2bec662a8\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-67b3d6bd-04f2-4a14-9ffc-bfd367597d12\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-7213ee1b-9291-4b43-bf9a-aa607ef57194\">해당 모델은 국가 핵심시설과 주요 산업 현장에 대한 실증을 거쳐 지속적으로 고도화될 예정이다. 전력·금융·과학기술·통신·반도체·방위산업·항공우주 등 7대 주요 분야에서 현장 실증을 진행하며, 외부망 접근이 제한되는 보안 환경에서도 안정적으로 운용할 수 있도록 &#x27;폐쇄망&#x27; 특화 운영 기술력을 완성한다는 구상이다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-d300c429-97dd-4a7d-bf4c-0ecf9b7c6dfa\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-66fed68b-bef1-4bd4-a5f5-b89171052c7d\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-91bf327f-51ed-4cd5-8fd6-3295a581ebff\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-dffccfd4-7f28-4933-a659-295ae643f115\">나아가 이번 사업을 통해 개발한 모델을 상업적 활용이 가능한 오픈소스로 공개하여 국내 보안 생태계 전반으로 결실을 확산시켜 나갈 예정이다. 중소기업을 위한 취약점 및 사이버 공격 탐지 무상 점검 서비스를 제공하는 한편, 네이버클라우드 마켓플레이스를 통한 국내 보안 기업들의 AI 서비스 상용화를 적극 지원해 국가 차원의 보안 AI 선순환 생태계를 구축해 나간다는 방침이다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7e5b3c7f-21c9-42d0-8f0d-fccddb3cc685\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b7603ab0-36b3-4aa0-9755-72050e6d1347\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b8baef41-a43a-4a6e-9134-692469376441\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-3c38880f-f60a-434c-9d9b-fa8f377bc756\">네이버클라우드 김유원 대표는 “이번 사업 수주는 네이버클라우드 컨소시엄이 보유한 대규모 AI 인프라와 데이터, 보안 전문 역량을 종합적으로 인정받은 결과”라며 “국가 핵심 인프라를 지키는 AI를 우리 기술로 만들어낸다는 책임감을 갖고 사업에 임해, 대한민국을 대표하는 국가 보안 AI 모델과 생태계를 만들어 가겠다”고 밝혔다. (끝)\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d4f50ff6-cdf9-40d8-b85e-b29f1bde531d\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-bb43c266-d72e-46cd-92b3-f15d7d5cb84c\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-490e78d6-1951-4191-a151-912eff6c1db3\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>    \u003C/div>\n\u003C/div>\n\u003C/div>\n\u003Cimg src=\"https://www.navercorp.com/img/favicon.ico\" style=\"width: 0px; height: 0px; visibility: hidden;\" onload=\"loadSeViewer('real');\" />",json:null,tnUrl:"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDNfNTMg/MDAxNzg4NDAxMzY2NTI3.PVQ_J0G6BHtz9Z2iMzTsGSFEX_FRD0NEBtytGZIWb8Qg.a0-WfhJkhWKEwul2QEDe4Quh0GqmK6D9bQ7RmSpV8e0g.PNG/%EC%8A%A4%ED%81%AC%EB%A6%B0%EC%83%B7_2026-08-07_151751.png?type=w480",tnDesc:null,tnBgColor:null,noticeYmd:"20260903",prev:{articleId:10034633,boardMetaId:"news",headline:null,title:"네이버, 네이버플러스 멤버십 이용자 전용 오프라인 페스티벌 연다",content:"\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://editor-static.pstatic.net/v/basic/1.76.0/css/se.viewer.desktop.css\">\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://static-homepage.pstatic.net/cdn-static/smart-editor/homepage_seviewer.css?20260909\">\n\u003Cdiv id=\"one-viewer\" class=\"one-viewer se_one_viewer_wrapper_880\">\u003Cdiv class=\"se-viewer se-theme-default\" lang=\"ko-KR\">\n    \u003C!-- SE_DOC_HEADER_START -->\n    \u003C!--@CONTENTS_HEADER-->\n    \u003C!-- SE_DOC_HEADER_END -->\n    \u003Cdiv class=\"se-main-container\">\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-59bc5bee-0387-41f9-8888-2900ed3e7b2e\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-825b2114-cc56-4d71-9490-f4d420ba1a1c\">\u003Cspan style=\"color:#00b050;\" class=\"se-fs-fs24 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b8a6303c-060e-4c10-ae1f-0f7ae7f0ad1c\">\u003Cb>“넾페스타에서는 모든 순간이 혜택”\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-3b08f2b3-8dd5-45c5-bb23-70012375c08b\">\u003Cspan style=\"color:#00b050;\" class=\"se-fs-fs30 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-05d2bce2-1f75-43f7-9563-ae9a6c4b4f79\">\u003Cb>네이버, 네이버플러스 멤버십 이용자 전용 오프라인 페스티벌 연다\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-39805eab-483b-49a5-9307-8b8667ab6f52\">\u003Cspan style=\"color:#000000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-685a9d5a-6f22-4595-8587-6c401b9d0721\">\u003Cb>- &#x27;Npay 페이스사인&#x27; 기반 입장부터 F&amp;B·굿즈 결제까지, &#x27;Npay 월렛 NFT&#x27; 스탬프 투어 진행\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-569ca9eb-b431-423d-bf83-1dbd9aa6791e\">\u003Cspan style=\"color:#000000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-decff0f1-e90d-419d-99dd-7999f445646a\">\u003Cb>- 멤버십 이용자 10월 6일(화) 선예매 오픈…2030 타겟 네이버 브랜드, 기술력 경험 제공\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-762ba2ae-e158-4f54-99ee-bca3a17cbefd\">\u003Cspan style=\"color:#ff0000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-f164e384-b3a5-4724-83f1-c10e8ed31afd\">\u003Cb> \u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-right \" style=\"\" id=\"SE-00105864-343e-4c48-9bb6-712f90f5eaf1\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-ffca5e41-f006-4ff3-b13b-60f400bcebd6\">2026-09-04\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-0eccbdc6-4fa9-4d3f-9bd0-c4fe6ee92793\">\u003Cspan style=\"color:#ff0000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-a3c635a6-e1f4-414c-87d9-7ffa2ed06f7a\">\u003Cb> \u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-4277d924-3b99-43a5-ab9c-a2447f17b114\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-dd08052e-0866-47f0-bea6-cbca891d73e7\">네이버㈜(대표이사 최수연)가 네이버플러스 멤버십 이용자를 위한 오프라인 페스티벌 ‘넾페스타’를 10월 30일(금)부터 11월 1일(일)까지 앤더슨씨 성수에서 개최한다고 밝혔다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-5fc130f2-2332-42c9-a52b-c086e4f63d4d\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-556cfb1a-a24f-4553-b9fa-0685fdb879a6\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7dd5c2a3-60eb-4d6e-811d-d15d3356e049\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-0c19d202-85bd-4cf5-8c27-dc18d003e3b0\">‘넾페스타’는 예약, 출입인증, 결제, NFT까지 네이버의 다양한 기술력이 접목된 네이버만의 쇼핑문화 음악공연이다. 네이버는 네이버플러스 멤버십 이용자들에게 네이버의 기술, 서비스로 온오프라인을 연계한 새로운 경험을 제공하기 위해 이번 이벤트를 준비했다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-f86dedfb-368e-4fb6-98c4-14b4169f5855\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-250de81d-123f-4adc-8d86-9d002c795a17\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b047fd4a-c233-40c0-98d4-cd4fd1175fcd\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b80499c1-8cac-48b3-9301-710e1e1d923b\">네이버는 ‘넾페스타’에 출연하는 아티스트 실리카겔, 루시, 자이언티, 카더가든, 권진아 및 쇼핑 참가 브랜드를 1차 공개했고, 순차적으로 쇼핑, 파트너존, F&amp;B 참가 브랜드, 아티스트 전체 라인업, 스페셜 굿즈 등을 안내할 예정이다. 10월 6일 13시에 선예매를, 10월 7일에 일반 예매를 진행한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-bd966f15-cd1b-45b0-a0a4-00cf35cd577b\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-cc2f0ff8-d057-42fd-963d-0fbf2fcc8574\">(*네이버 멤버십 이용자 대상으로 예매를 진행하며, 9월 4일부터 10월 5일까지 Npay로 20만원 이상 결제 시 선예매 혜택 제공)\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b5a1c796-b337-444e-9489-83143cf1f567\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-1708b72e-44e0-4383-84c9-f44345a948a2\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7ce39aae-689f-476f-815f-6a163745b8fd\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-a4153db5-96bb-441e-9dac-ce1db6f1976c\">‘넾페스타’ 현장은 Npay 페이스사인(Facesign)으로 더욱 빠르고 안전한 입장 경험을 제공할 예정이다. 페이스사인은 네이버가 자체 개발한 딥러닝 기반 얼굴 인식 모델로, 워크스루(walk-thru) 방식의 빠른 인증은 물론 안티스푸핑(anti-spoofing) 기술과 양자내성암호(PQC)가 적용되어 얼굴정보를 안전하게 보관·운영한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-2d23e756-2afe-4334-a885-c42e826322df\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-15481d7f-4b43-4889-9593-734b38eb072f\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-5bc69a12-f2e3-495b-b102-3d08d21fbf4a\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-2f023c3a-c615-42b2-82d0-fa74f4f104fe\">또한 현장에서는 Npay 월렛 기반으로 영구 소장 가능한 형태의 NFT 스탬프 투어 이벤트를 통해 디지털 기반의 새로운 관람 경험을 제공할 계획이다. &#x27;Npay 월렛&#x27;은 네이버 아이디를 기반으로 누구나 쉽게 이용할 수 있는 Web3 디지털 자산 지갑 서비스로, 티켓과 같은 디지털 자산을 안전하게 보관·관리해 티켓의 위·변조와 부정 거래를 방지하는 데 기여한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b83d92d8-b71e-4cb1-b473-e8deeb2e4b1c\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-e1573345-ec36-40ba-98a6-5a7b77f6edb5\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-083f9f31-37d7-4fc0-9c75-3b2be7fb44a2\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-0e8ef1a6-0e84-4fd9-925c-973edf5a2b28\">아울러 ‘넾페스타’에 입점한 다양한 브랜드 존에서 오프라인 통합 단말기 &#x27;Npay 커넥트&#x27;를 통한 페이스사인 결제까지 가능해 네이버의 혁신적인 브랜드 경험을 제공한다. 행사 기간 중에는 성수 지역 내 &#x27;Npay 커넥트&#x27; 도입 매장을 대상으로 별도 프로모션도 함께 운영된다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-147ecc07-35bb-40a1-b090-0d367bb97045\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-f24ec8d8-df93-4648-a39b-304bb74f6161\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-196a01bf-b00a-48e2-9d85-899b8b0cc62b\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-1408ad5a-4453-4078-bb38-d3e1eaf99c1d\">또한 네이버 브랜드스토어에 입점한 뷰티, 라이프스타일, 푸드 등 다양한 브랜드를 소개하고 체험할 수 있는 공간도 마련한다. 네이버플러스 스토어 주요 브랜드사들은 특별 부스를 운영해 입장객 전원에게 한정 굿즈를 제공하며 네이버 멤버십 고객 중심의 차별적인 쇼핑 경험을 선사한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-ba0f409f-6604-4730-837e-568ab5665557\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-9ff0db6c-2c87-4f5b-8ea2-0f35747b2337\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-6e758f0e-9f59-4fd5-90fd-81ff3f993276\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-a9379518-624a-49f6-9ceb-b0bdf70054c0\">네이버 브랜드 경험 심준용 리더는 “네이버의 쇼핑, 예약, 결제 등 전사적 역량을 결합한 오프라인 멤버십 페스티벌 ‘넾페스타’는 2030 이용자를 대상으로 아티스트 공연부터 브랜드 체험존까지 다양하게 준비했다”며 “향후에도 네이버의 온오프라인 생태계를 연결한 다양한 혁신적 이벤트를 선보이겠다”라고 밝혔다. (끝)\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-e7c2ccbc-6bc2-4cc8-b23d-e5c4d1ff94e2\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-8a011327-23b2-497c-afdd-27a636b14806\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-59bc5bee-0387-41f9-8888-2900ed3e7b2e\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>                \u003Cdiv class=\"se-component se-image se-l-default\" id=\"SE-ec0016d0-4053-4ac1-8361-2fd5df5a9a1b\">\n                    \u003Cdiv class=\"se-component-content se-component-content-fit\">\n                        \u003Cdiv class=\"se-section se-section-image se-l-default se-section-align-center\" >\n                                \u003Cdiv class=\"se-module se-module-image\" style=\"\">\n                                    \u003Ca href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-ec0016d0-4053-4ac1-8361-2fd5df5a9a1b\", \"src\" : \"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDRfMjUx/MDAxNzg4NDg4Mjg0ODk2.pZkRFTSk0sOqSoIjEYdIXfWHLwdZRTm6LLoVjbOVwG4g.nZEByyNDgsEcfcfD7fvInAn6W9jDOXSPyebmaBKWSNog.JPEG/%EB%84%BE%ED%8E%98%EC%8A%A4%ED%83%80.jpg\", \"originalWidth\" : \"1080\", \"originalHeight\" : \"720\", \"linkUse\" : \"false\", \"link\" : \"\", \"fileSize\": \"194112\" }'>\n                                        \u003Cimg src=\"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDRfMjUx/MDAxNzg4NDg4Mjg0ODk2.pZkRFTSk0sOqSoIjEYdIXfWHLwdZRTm6LLoVjbOVwG4g.nZEByyNDgsEcfcfD7fvInAn6W9jDOXSPyebmaBKWSNog.JPEG/%EB%84%BE%ED%8E%98%EC%8A%A4%ED%83%80.jpg\" alt=\"\" class=\"se-image-resource\" />\n                                    \u003C/a>\n                                \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-ec0016d0-4053-4ac1-8361-2fd5df5a9a1b\", \"data\": {\"ctype\": \"image\", \"ai\": \"false\", \"fileSize\": \"194112\" }}'>\u003C/script>\n                \u003C/div>\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-e4a83e23-6b0a-4a41-8f95-d71143e20514\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-center \" style=\"\" id=\"SE-0378a17c-c68d-497e-a96a-4fdf52c95155\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-84ddfe32-633a-43bb-ba8a-d7db3a71478e\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-e4a83e23-6b0a-4a41-8f95-d71143e20514\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>    \u003C/div>\n\u003C/div>\n\u003C/div>\n\u003Cimg src=\"https://www.navercorp.com/img/favicon.ico\" style=\"width: 0px; height: 0px; visibility: hidden;\" onload=\"loadSeViewer('real');\" />",json:null,tnUrl:"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDRfMzAg/MDAxNzg4NDg4MjU1NjY0.eulAYUMMV4lfdcdDWHJIFjE5xfSZ9lWo1ce_3RvApqQg.D3SE-jYynVGJtdrVGuy-5hcSwefNisWDNCDcsXEVn9Ug.JPEG/%EB%84%BE%ED%8E%98%EC%8A%A4%ED%83%80.jpg?type=w480",tnDesc:null,tnBgColor:null,noticeYmd:"20260904",prev:null,next:null,fileList:[],factsheet:null,mainImgUrl:null,keywordList:[],relatedUrl:null,category:null,categoryNm:null,vodOption:null,imageList:[],period:null,author:null,contentsTextYn:"Y",contentsImageYn:"Y",pid:null,nid:null},next:{articleId:10034627,boardMetaId:"news",headline:null,title:"네이버 예약, JW 메리어트 호텔과 ‘미쉐린 스타 셰프’ 미식 행사 진행",content:"\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://editor-static.pstatic.net/v/basic/1.76.0/css/se.viewer.desktop.css\">\u003Clink type=\"text/css\" rel=\"preload stylesheet\" href=\"https://static-homepage.pstatic.net/cdn-static/smart-editor/homepage_seviewer.css?20260909\">\n\u003Cdiv id=\"one-viewer\" class=\"one-viewer se_one_viewer_wrapper_880\">\u003Cdiv class=\"se-viewer se-theme-default\" lang=\"ko-KR\">\n    \u003C!-- SE_DOC_HEADER_START -->\n    \u003C!--@CONTENTS_HEADER-->\n    \u003C!-- SE_DOC_HEADER_END -->\n    \u003Cdiv class=\"se-main-container\">\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-0bc151a4-a8fb-4b76-b566-d6b13599c4e9\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-8d1959f9-b17d-49aa-a2e0-034c1a31b4ad\">\u003Cspan style=\"color:#00b050;\" class=\"se-fs-fs30 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-fc7e5ae0-42c3-4288-8b65-4521c141c9b7\">\u003Cb>‘일상 넘어 특별한 경험까지 예약으로 연결’…네이버 예약, JW 메리어트 호텔과 ‘미쉐린 스타 셰프’ 미식 행사 진행\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-36c33610-91e3-4d4b-89b8-d5a177190908\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-71363b43-fa14-4379-a6ed-a21f5493e967\">\u003Cb>- 네이버 예약 전용 이색 다이닝 프로모션, 9월~11월 약 3개월간 메리어트 서울 시작으로 제주, 동대문 등 총 세 곳에서 순차 진행\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-6fc6f84b-d719-4fc9-a6bb-1618086b9aa2\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b95146a7-7e20-4a15-8779-b0bed05b450a\">\u003Cb>- 네이버 예약 연동한 외부 파트너사와 지속 협업 확대…플레이스 연동 파트너사 총 누적 예약수 약 1억 1,500만 건, YoY 14% 증가…거래액 수도 15% 증가해\u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-45d2be91-b8bc-46c4-ae90-8288fbabf456\">\u003Cspan style=\"color:#ff0000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-84b4fa4e-4443-4c41-8b75-2c10a77b0b1f\">\u003Cb> \u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-right \" style=\"\" id=\"SE-c342bb62-ca86-4176-b230-bf330b381011\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-7df7cd7f-030d-4b8b-872a-ff6058833224\">2026-09-03\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b0ddc15a-defe-4852-826b-660902f099ed\">\u003Cspan style=\"color:#ff0000;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-97b30e54-e98f-41a3-a9da-6df7f65782bb\">\u003Cb> \u003C/b>\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-baba0a36-6c7f-4762-bb6a-523b0bd59e03\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-5d78884b-3f2f-4cdd-ac91-b5c24be507d4\">네이버가 JW 메리어트 호텔과 손잡고 미쉐린 스타 셰프의 특별 참여로 이뤄지는 이색 다이닝 경험을 선사한다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-19edf0d8-e56f-4602-80ad-842628e88c5b\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-ac426baa-3349-45e0-8632-afcc397a3341\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-9b6cfc9d-e299-46a7-8d2d-6bfed8ea0f6f\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-f3a353fc-e05f-4d25-b381-c160be5a3de7\">네이버㈜(대표이사 최수연)는 JW 메리어트 호텔과 함께 미쉐린 스타를 획득한 음식점 대표 셰프들의 한정 메뉴를 선보이는 네이버 예약 전용 프로모션을 9월부터 11월까지 순차 진행한다고 3일 밝혔다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-ec4319a8-cc06-4e3b-9e23-7e5b93a00f83\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-3eb90ca1-b97e-47d7-8141-fcbf4dbc75c3\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-0bc151a4-a8fb-4b76-b566-d6b13599c4e9\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>                \u003Cdiv class=\"se-component se-image se-l-default\" id=\"SE-37c4c4a0-8cf8-453a-8b68-8538abb6d997\">\n                    \u003Cdiv class=\"se-component-content se-component-content-fit\">\n                        \u003Cdiv class=\"se-section se-section-image se-l-default se-section-align-\" >\n                                \u003Cdiv class=\"se-module se-module-image\" style=\"\">\n                                    \u003Ca href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-37c4c4a0-8cf8-453a-8b68-8538abb6d997\", \"src\" : \"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDNfODcg/MDAxNzg4Mzk4MzkyOTEz.R72tk0TzpQQ9erz12o-elrkRtKIKaUBi6YLtruF5o8Ag.RCJt_BeE0Bs4YOwS56WML2J_ay9BrxQeYpUgNRa14v8g.PNG/%EB%84%A4%EC%9D%B4%EB%B2%84_%EC%98%88%EC%95%BDx%EB%A9%94%EB%A6%AC%EC%96%B4%ED%8A%B8_%ED%98%B8%ED%85%94_%EB%AF%B8%EC%89%90%EB%A6%B0_%EC%8A%A4%ED%83%80%EC%85%B0%ED%94%84_%EA%B0%88%EB%9D%BC%EB%94%94%EB%84%88.png\", \"originalWidth\" : \"1600\", \"originalHeight\" : \"1600\", \"linkUse\" : \"false\", \"link\" : \"\", \"fileSize\": \"962207\" }'>\n                                        \u003Cimg src=\"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDNfODcg/MDAxNzg4Mzk4MzkyOTEz.R72tk0TzpQQ9erz12o-elrkRtKIKaUBi6YLtruF5o8Ag.RCJt_BeE0Bs4YOwS56WML2J_ay9BrxQeYpUgNRa14v8g.PNG/%EB%84%A4%EC%9D%B4%EB%B2%84_%EC%98%88%EC%95%BDx%EB%A9%94%EB%A6%AC%EC%96%B4%ED%8A%B8_%ED%98%B8%ED%85%94_%EB%AF%B8%EC%89%90%EB%A6%B0_%EC%8A%A4%ED%83%80%EC%85%B0%ED%94%84_%EA%B0%88%EB%9D%BC%EB%94%94%EB%84%88.png\" alt=\"\" class=\"se-image-resource\" />\n                                    \u003C/a>\n                                \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-37c4c4a0-8cf8-453a-8b68-8538abb6d997\", \"data\": {\"ctype\": \"image\", \"ai\": \"false\", \"fileSize\": \"962207\" }}'>\u003C/script>\n                \u003C/div>\n                \u003Cdiv class=\"se-component se-text se-l-default\" id=\"SE-405fb45c-7d33-4b2d-ae35-8f07456593dc\">\n                    \u003Cdiv class=\"se-component-content\">\n                        \u003Cdiv class=\"se-section se-section-text se-l-default\">\n                            \u003Cdiv class=\"se-module se-module-text\">\n                                    \u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a28a3692-fd95-4c4a-a308-b63d15cc3cc8\">\u003Cspan style=\"\" class=\"se-fs-fs19 se-ff-nanumsquareneo   \" id=\"SE-8637913b-e824-43e7-8253-99c4e88401e7\">​\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-e48195e9-a0cd-4403-a8fe-e9387baf95a4\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-d9481161-78c4-419f-95b2-10948e26a181\">이번 행사는 네이버가 JW 메리어트 호텔과 공동 기획한 프로모션으로 플레이스 예약을 통한 이용자들의 호텔 다이닝 접근성을 높이고, 다채로운 미식 경험을 지원하기 위한 취지로 마련됐다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-de51ee0c-324d-4ff3-b98f-2899032a3d88\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-de9bee8d-ed56-4a17-896e-6ddb4bb6c9a6\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-736dbccb-012b-4f90-be84-0e4de8e23d1a\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-2164c862-87fc-4db9-92c5-42d530812d6d\">특히 기존 네이버 예약을 통해 일상적으로 접할 수 있었던 음식점 방문 경험에서 나아가 한정된 기간에만 참여할 수 있는 특별 이벤트로 진행돼 이용자들에게 한층 이색적인 경험이 될 것으로 기대된다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-6cd6bcf5-89a5-4b3d-b711-da5b53ac524e\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-55fe0367-c9a3-469a-bcb1-ca5c2cc09f9d\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-096bb18b-0ce4-4650-9ca6-30e5ed2af010\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-791d41cc-937b-4013-b4e8-270822fb8860\">행사는 오는 9월 10일 메리어트 서울점을 시작으로 제주, 동대문 등 총 세 곳의 메리어트 호텔에서 순차적으로 진행되며, 11월 30일까지 약 3개월간 이어진다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-ad1e08e1-8ccf-406e-849c-1d2f1c1b7f02\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-2e8ee8fe-ead6-4db1-bb6a-9af92c198657\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-41fe5200-a0fd-4669-a574-d660e4fc2fda\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-27023133-e2ff-4e17-a678-372bfc9f3779\">호텔 지점별로 ▲강민철(강민철 레스토랑, 기와강) ▲이준(스와니예) ▲권우중(권숙수) ▲원진희·최현아(가겐 by 최준호) 셰프 등이 참여하여 메리어트 호텔 소속 셰프들과 함께 각각의 테마에 맞춰 준비된 특별한 코스 요리를 선보일 예정이다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-43b6d01c-4307-41ca-bca6-9703f22941d2\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-479042e2-aa22-4752-8b73-a455eb7e5401\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-cfe1d7f3-1273-45ad-a1cd-74bcefcbd709\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b2324069-cd52-4027-9c0c-7db652ba6aaa\">지점별 행사 첫 날에는 메뉴 구성을 전담한 셰프가 직접 참석하여 선보이는 특별 만찬(갈라 디너)이 제공되고, 그 다음날부터 약 한 달 동안 각 호텔 대표 식당에서 해당 메뉴를 지속 경험할 수 있다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7a4f4b48-2df9-45ad-b17b-e46996ab9fb6\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-9f988fbd-e8ed-4e8a-856c-ab26fe3e9505\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7c74771c-32ec-48a4-af6e-92d5f1c18633\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-7cb21254-88a6-46f8-b936-cc63de5b19bb\">예를 들어, 강민철 셰프가 참여하는 1회차 행사의 갈라 디너는 9월 10일 메리어트 서울에서 진행되며, 이후 해당 메뉴를 ‘더 마고 그릴’에서 9월 11일부터 30일까지 제공하는 식이다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-0f88f0f3-8b8b-4899-9723-5dca80ab6ce2\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-7ab7a7eb-d7d9-4934-bcec-cc4595c0b87e\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-912ba178-d6f4-499b-9596-502de3ec7483\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-b9d21401-a6cf-44f6-b6fd-3e136f2f1e53\">전체 행사 개요 및 세부 내용은 각 호텔 네이버 플레이스 상세 정보를 통해 확인할 수 있고, 참가 신청은 네이버 예약을 통해서만 가능하다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-8f1cdedd-997a-48e0-aa5a-b481a203925b\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-54d770dd-1fd3-4bbb-bc7f-74b4fb11228d\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-03a91c3d-f47a-4fb0-bdac-5a8b1c65f5f2\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-5db0ed15-d421-4188-a420-65b26fd1ecb3\">이처럼 네이버 예약은 이를 연동해 활용하는 외부 파트너사 대상 업종별 맞춤 기능을 고도화하고, 성장세를 함께 이어갈 수 있는 프로모션을 진행하는 등 협업을 적극 확대해오고 있다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-c4fe8d7f-a1e7-471e-a626-27119e328073\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-a9ac2cda-b52e-4882-898d-51f94ccd35a6\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-df9c3ea7-f250-4f9f-8c42-6406f5735fc0\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-14a1c858-399c-493f-9e1c-570834f2d7ea\">이용자들의 큰 호응 속에 음식점, 미용실, 숙박, 레저, 공연·전시, 병의원 등 업종들로 네이버 예약 생태계 전반이 지속적으로 확대되며, 예약을 연동하여 활용하는 외부 파트너사는 물론 이들 플랫폼에 기반한 사업주들 또한 큰 폭의 성장 효과를 본 것으로 나타났다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-1f2ea91d-2c0f-4aea-95d8-854fcbb44734\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-e1a3d2fe-898a-46d4-9f27-4cbf32fede4f\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-efae2172-5073-4847-8ffc-218535b63066\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-8b788251-7413-400f-9e3a-ca6cb1d8536e\">지난 6월 기준 네이버 예약과 연동된 파트너사의 총 누적 예약수는 약 1억 1,500만 건으로, 지난해 같은 기간과 비교해 약 14% 증가했다. 파트너사 이용자가 네이버 예약을 거쳐 실제 결제까지 완료한 거래액 규모도 전년 대비 약 15% 늘어난 것으로 확인됐다.\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-5133a1be-5367-42e1-9abd-69f18b63930b\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-1127d15b-1d8d-481b-b3ba-979d1b2eecef\"> \u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\u003C!-- SE-TEXT { -->\u003Cp class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-d5252541-116b-40d9-ad01-54f2bba42587\">\u003Cspan style=\"color:#202124;\" class=\"se-fs-fs19 se-ff-nanumsquareneo  se-style-unset \" id=\"SE-e34916fc-8ad5-4d7b-ba4b-989244b48212\">네이버 플레이스 사업 기획 이세훈 리더는 “네이버 예약은 일상적인 장소 방문을 넘어 이용자들이 특별한 경험을 보다 쉽게 탐색하고 즐길 수 있도록 서비스 영역을 지속 확대해 가고자 한다”면서 “앞으로도 호텔, 파인다이닝 등 다양한 파트너들과 협업해 차별화된 예약 경험을 선보이겠다”고 밝혔다. (끝)\u003C/span>\u003C/p>\n\u003C!-- } SE-TEXT -->\n                            \u003C/div>\n                        \u003C/div>\n                    \u003C/div>\n                    \u003Cscript type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-405fb45c-7d33-4b2d-ae35-8f07456593dc\", \"data\": {\"ctype\": \"text\"  }}'>\u003C/script>\n                \u003C/div>    \u003C/div>\n\u003C/div>\n\u003C/div>\n\u003Cimg src=\"https://www.navercorp.com/img/favicon.ico\" style=\"width: 0px; height: 0px; visibility: hidden;\" onload=\"loadSeViewer('real');\" />",json:null,tnUrl:"https://corp-homepage-phinf.pstatic.net/MjAyNjA5MDNfMTMy/MDAxNzg4Mzk4NDM0NDI1.xji7auiRXoj-Gyiv9exxZiD1ClcOxhPf_XzO_DN33Swg.RUDizJfD7ykrQMnZnfr-v6Tq7OLzt-9C6R6wXqL9axgg.PNG/%EB%84%A4%EC%9D%B4%EB%B2%84_%EC%98%88%EC%95%BDx%EB%A9%94%EB%A6%AC%EC%96%B4%ED%8A%B8_%ED%98%B8%ED%85%94_%EB%AF%B8%EC%89%90%EB%A6%B0_%EC%8A%A4%ED%83%80%EC%85%B0%ED%94%84_%EA%B0%88%EB%9D%BC%EB%94%94%EB%84%88.png?type=w480",tnDesc:null,tnBgColor:null,noticeYmd:"20260903",prev:null,next:null,fileList:[],factsheet:null,mainImgUrl:null,keywordList:[],relatedUrl:null,category:null,categoryNm:null,vodOption:null,imageList:[],period:null,author:null,contentsTextYn:"Y",contentsImageYn:"Y",pid:null,nid:null},fileList:[],factsheet:null,mainImgUrl:null,keywordList:[],relatedUrl:null,category:null,categoryNm:null,vodOption:null,imageList:[],period:null,author:null,contentsTextYn:"Y",contentsImageYn:"N",pid:10034633,nid:10034627},related:[],headerTheme:"black",headerBackground:"transparent"},uses:{search_params:["seq"],parent:1}}],
							form: null,
							error: null
						});
					});
				}
			</script>
		</div>

		<!-- NAVER 소셜 플러그인 — 원본 패턴 (homepage-navercorp/src/views/include/script.html) -->
		<!--
			Race 가드: homepage_socialplugins.js 의 window.onload 핸들러가 SocialPlugIn_Core 를 호출하는데
			SocialPlugIn_Core 는 splugin.m.js 가 async 로 추가 로드되면서 등록되는 함수.
			window.onload 발화 시점에 splugin.m.js 가 아직 로드 안 됐으면 ReferenceError 가 발생.
			noop 으로 미리 글로벌을 점유하면 늦게 로드되더라도 에러 없이 진행.
		-->
		<script>
			window.SocialPlugIn_Core =
				window.SocialPlugIn_Core ||
				function () {
					return {};
				};
		</script>
		<script src="https://static-homepage.pstatic.net/cdn-static/plugins/homepage_socialplugins.js?v=1"></script>
		<script>
			// homepage_socialplugins.js 의 `const HomepageSocialPlugins = ...` 는 모던 브라우저에서
			// script-scoped 라 window 에 attach 되지 않는다. 원본 navercorp 와 동일하게 식별자 직접 참조.
			// 다만 외부 스크립트 로드 실패/지연 시 ReferenceError 방지를 위해 typeof 가드.
			(function () {
				if (typeof HomepageSocialPlugins !== 'function') return;
				if (window.__homepageSocialPluginsInitialized) return;
				window.__homepageSocialPluginsInitialized = true;
				const lang = (navigator.language || 'ko').toLowerCase().indexOf('ko') === 0 ? 'ko' : 'en';
				HomepageSocialPlugins('real', lang, document.title, '');
			})();
		</script>
	</body>
</html>
