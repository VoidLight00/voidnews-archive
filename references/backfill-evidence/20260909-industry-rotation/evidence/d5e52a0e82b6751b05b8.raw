			<script>
				document.addEventListener('DOMContentLoaded', function () {
					var bannerElement = document.querySelector(
						'.header-slide-banner-swiper'
					);

					if (!bannerElement) {
						return;
					}

					var slideCount = Number(
						bannerElement.getAttribute('data-slide-count')
					);

					function playActiveVideo(swiper) {
						var videos = bannerElement.querySelectorAll('video');

						videos.forEach(function (video) {
							video.pause();
							video.currentTime = 0;
						});

						var activeSlide = swiper.slides[swiper.activeIndex];

						if (!activeSlide) {
							return;
						}

						var isMobile = window.matchMedia('(max-width: 767px)').matches;

						var activeVideo = activeSlide.querySelector(
							isMobile
								? '.header-banner-media-mo video'
								: '.header-banner-media-pc video'
						);

						if (activeVideo) {
							activeVideo.play().catch(function () {});
						}
					}

					var headerSlideBanner = new Swiper(
						bannerElement,
						{
							direction: 'vertical',
							slidesPerView: 1,
							spaceBetween: 0,

							loop: slideCount > 1,

							speed: 700,

							allowTouchMove: false,
							simulateTouch: false,

							autoplay: slideCount > 1
								? {
									delay: 2000,
									disableOnInteraction: false
								}
								: false,

							on: {
								init: function () {
									playActiveVideo(this);
								},

								slideChangeTransitionStart: function () {
									var videos = bannerElement.querySelectorAll('video');

									videos.forEach(function (video) {
										video.pause();
									});
								},

								slideChangeTransitionEnd: function () {
									playActiveVideo(this);
								}
							}
						}
					);
				});
			</script>
