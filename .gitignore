# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local automation outputs
/_workspace/
CLAUDE.md
.supabase-secrets/
.env.local
.env*.local

# Claude Code 작업 중 캡처/메모 (commit 의도 X)
.claude-*.png
VOL*_HANDOFF.md

# Claude Code per-project workspace
.claude/
.tmp/

# The global ignore file carries **/Cache/, and core.ignorecase makes it swallow the
# lowercase cache/ directories inside the hash-bound evidence corpus. Re-include them:
# these are gate inputs, not build caches.
!references/backfill-evidence/**/cache/
!references/backfill-evidence/**/cache/**
